PORT=8787
ANTHROPIC_API_KEY=
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=

# Email-code (OTP) login — sent via Brevo. Leave all of these unset to run in
# mock mode (codes are logged to the server console instead of emailed).
# Brevo gives two different kinds of credential — use whichever one you have,
# only one is needed:
#   REST API key (Transactional > SMTP & API > API Keys, starts "xkeysib-")
BREVO_API_KEY=
#   SMTP key (Transactional > SMTP & API > SMTP tab, starts "xsmtpsib-")
BREVO_SMTP_KEY=
BREVO_SMTP_LOGIN=
# Required either way — must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=
